    "gitDecoration.modifiedResourceForeground": "#6C98FF",
    "gitDecoration.deletedResourceForeground": "#FF7A3D",
    "diffEditor.insertedTextBackground": "#0F94A055",
    "diffEditor.removedTextBackground": "#FF7A3D44"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#ACC4CE", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#8CEBF2" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#17D7E8" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#BFF7FB" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": { "foreground": "#8EAEFF" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#6C98FF" }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#EAF7FA" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF7A3D" }
    }
  ],
  "semanticTokenColors": {
    "class": "#8EAEFF",
    "enum": "#8EAEFF",
    "function": "#BFF7FB",
    "method": "#BFF7FB",
    "parameter": "#EAF7FA",
    "property": "#8CEBF2",
    "variable.readonly": "#6C98FF",
    "type": "#8EAEFF"
  }
}
