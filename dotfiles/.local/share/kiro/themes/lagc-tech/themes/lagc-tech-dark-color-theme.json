    "editorGroup.focusedEmptyBorder": "#17D7E8",
    "tab.activeBackground": "#061B2B",
    "tab.activeForeground": "#EAF7FA",
    "tab.border": "#164B60",
    "tab.activeBorder": "#17D7E8",
    "tab.activeBorderTop": "#17D7E8",
    "tab.lastPinnedBorder": "#164B60",
    "tab.inactiveBackground": "#0A2740",
    "tab.inactiveForeground": "#ACC4CE",
    "panel.background": "#0A2740",
    "panel.border": "#164B60",
    "panelTitle.activeForeground": "#EAF7FA",
    "panelTitle.activeBorder": "#17D7E8",
    "panelTitle.border": "#164B60",
    "panelSection.border": "#164B60",
    "panelSectionHeader.border": "#164B60",
    "statusBar.background": "#061B2B",
    "statusBar.foreground": "#EAF7FA",
    "statusBar.border": "#164B60",
    "statusBarItem.hoverBackground": "#103551",
    "terminal.background": "#061B2B",
    "terminal.border": "#164B60",
    "terminal.foreground": "#EAF7FA",
    "terminalCursor.foreground": "#17D7E8",
    "terminal.ansiBlack": "#061B2B",
    "terminal.ansiRed": "#FF7A3D",
    "terminal.ansiGreen": "#17D7E8",
    "terminal.ansiYellow": "#FFB18D",
    "terminal.ansiBlue": "#1B5CFF",
    "terminal.ansiMagenta": "#8EAEFF",
    "terminal.ansiCyan": "#8CEBF2",
    "terminal.ansiWhite": "#EAF7FA",
    "terminal.ansiBrightBlack": "#587182",
    "terminal.ansiBrightRed": "#FF9666",
    "terminal.ansiBrightGreen": "#8CEBF2",
    "terminal.ansiBrightYellow": "#FFD5C2",
    "terminal.ansiBrightBlue": "#6C98FF",
    "terminal.ansiBrightMagenta": "#B8CBFF",
    "terminal.ansiBrightCyan": "#BFF7FB",
    "terminal.ansiBrightWhite": "#F7FCFD",
