    "list.hoverBackground": "#103551",
    "list.highlightForeground": "#17D7E8",
    "list.focusBackground": "#17D7E8",
    "list.focusForeground": "#061B2B",
    "list.focusIconForeground": "#061B2B",
    "list.focusOutline": "#0F94A0",
    "list.focusAndSelectionOutline": "#0F94A0",
    "quickInput.background": "#0A2740",
    "quickInput.foreground": "#EAF7FA",
    "quickInput.titleBackground": "#061B2B",
    "quickInputList.focusBackground": "#17D7E8",
    "quickInputList.focusForeground": "#061B2B",
    "quickInputList.focusIconForeground": "#061B2B",
    "editor.background": "#061B2B",
    "editor.foreground": "#EAF7FA",
    "editorCursor.foreground": "#17D7E8",
    "editor.lineHighlightBackground": "#0A2740",
    "editor.selectionBackground": "#0F94A0",
    "editor.inactiveSelectionBackground": "#164B60",
    "editor.selectionHighlightBackground": "#164B60",
    "editor.findMatchBackground": "#1B5CFF",
    "editor.findMatchHighlightBackground": "#164CCF",
    "editor.wordHighlightBackground": "#164B60",
    "editor.wordHighlightStrongBackground": "#123CA6",
    "editorLineNumber.foreground": "#587182",
    "editorLineNumber.activeForeground": "#B9D2DB",
    "editorIndentGuide.background1": "#103551",
    "editorIndentGuide.activeBackground1": "#4D90A3",
    "editorBracketMatch.background": "#103551",
    "editorBracketMatch.border": "#17D7E8",
    "editorError.foreground": "#FF7A3D",
    "editorWarning.foreground": "#FFB18D",
    "editorInfo.foreground": "#17D7E8",
    "editorHint.foreground": "#8CEBF2",
    "editorGutter.addedBackground": "#17D7E8",
    "editorGutter.modifiedBackground": "#1B5CFF",
    "editorGutter.deletedBackground": "#FF7A3D",
    "editorGroup.border": "#164B60",
    "editorGroupHeader.tabsBackground": "#0A2740",
    "editorGroupHeader.tabsBorder": "#164B60",
