    "gitDecoration.modifiedResourceForeground": "#1B5CFF",
    "gitDecoration.deletedResourceForeground": "#C94D1F",
    "diffEditor.insertedTextBackground": "#17D7E833",
    "diffEditor.removedTextBackground": "#FF7A3D33"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#587182", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#0B727B" }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": { "foreground": "#1B5CFF" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#1042C4" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": { "foreground": "#123CA6" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#164CCF" }
    },
    {
      "scope": ["variable", "identifier"],
      "settings": { "foreground": "#061B2B" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C94D1F" }
    }
  ],
  "semanticTokenColors": {
    "class": "#123CA6",
    "enum": "#123CA6",
    "function": "#1042C4",
    "method": "#1042C4",
    "parameter": "#061B2B",
    "property": "#0B727B",
    "variable.readonly": "#164CCF",
    "type": "#123CA6"
  }
}
