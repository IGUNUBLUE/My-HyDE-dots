    "list.highlightForeground": "#1042C4",
    "list.focusBackground": "#17D7E8",
    "list.focusForeground": "#061B2B",
    "list.focusIconForeground": "#061B2B",
    "list.focusOutline": "#0F94A0",
    "list.focusAndSelectionOutline": "#0F94A0",
    "quickInput.background": "#F7FCFD",
    "quickInput.foreground": "#061B2B",
    "quickInput.titleBackground": "#EAF7FA",
    "quickInputList.focusBackground": "#17D7E8",
    "quickInputList.focusForeground": "#061B2B",
    "quickInputList.focusIconForeground": "#061B2B",
    "editor.background": "#F7FCFD",
    "editor.foreground": "#061B2B",
