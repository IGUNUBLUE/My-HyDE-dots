    "editor.inactiveSelectionBackground": "#DCEBF0",
    "editor.selectionHighlightBackground": "#DCEBF0",
    "editor.findMatchBackground": "#8EAEFF",
    "editor.findMatchHighlightBackground": "#B8CBFF",
    "editor.wordHighlightBackground": "#DCEBF0",
    "editor.wordHighlightStrongBackground": "#B8CBFF",
    "editorLineNumber.foreground": "#587182",
    "editorLineNumber.activeForeground": "#061B2B",
    "editorIndentGuide.background1": "#DCEBF0",
    "editorIndentGuide.activeBackground1": "#74AAB9",
    "editorBracketMatch.background": "#EAF7FA",
    "editorBracketMatch.border": "#1B5CFF",
    "editorError.foreground": "#C94D1F",
    "editorWarning.foreground": "#E86129",
    "editorInfo.foreground": "#1042C4",
    "editorHint.foreground": "#0F94A0",
    "editorGutter.addedBackground": "#0F94A0",
    "editorGutter.modifiedBackground": "#1B5CFF",
