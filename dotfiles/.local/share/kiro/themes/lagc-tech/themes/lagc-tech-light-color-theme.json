    "editorGroup.focusedEmptyBorder": "#17D7E8",
    "tab.activeBackground": "#F7FCFD",
    "tab.activeForeground": "#061B2B",
    "tab.border": "#B9D2DB",
    "tab.activeBorder": "#1B5CFF",
    "tab.activeBorderTop": "#1B5CFF",
    "tab.lastPinnedBorder": "#B9D2DB",
    "tab.inactiveBackground": "#EAF7FA",
    "tab.inactiveForeground": "#587182",
    "panel.background": "#EAF7FA",
    "panel.border": "#B9D2DB",
    "panelTitle.activeForeground": "#061B2B",
    "panelTitle.activeBorder": "#1B5CFF",
    "panelTitle.border": "#B9D2DB",
    "panelSection.border": "#B9D2DB",
    "panelSectionHeader.border": "#B9D2DB",
    "statusBar.background": "#F7FCFD",
    "statusBar.foreground": "#061B2B",
    "statusBar.border": "#B9D2DB",
    "statusBarItem.hoverBackground": "#EAF7FA",
    "terminal.background": "#F7FCFD",
    "terminal.border": "#B9D2DB",
    "terminal.foreground": "#061B2B",
    "terminalCursor.foreground": "#1B5CFF",
    "terminal.ansiBlack": "#061B2B",
    "terminal.ansiRed": "#C94D1F",
    "terminal.ansiGreen": "#0F94A0",
    "terminal.ansiYellow": "#E86129",
    "terminal.ansiBlue": "#1B5CFF",
    "terminal.ansiMagenta": "#1042C4",
    "terminal.ansiCyan": "#0B727B",
    "terminal.ansiWhite": "#F7FCFD",
    "terminal.ansiBrightBlack": "#587182",
    "terminal.ansiBrightRed": "#FF7A3D",
    "terminal.ansiBrightGreen": "#17D7E8",
    "terminal.ansiBrightYellow": "#FFB18D",
    "terminal.ansiBrightBlue": "#4880FF",
    "terminal.ansiBrightMagenta": "#6C98FF",
    "terminal.ansiBrightCyan": "#61E2EC",
    "terminal.ansiBrightWhite": "#FFFFFF",
