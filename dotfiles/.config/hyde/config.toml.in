# Configuration file for HyDE
# Environment variables should be on top
# Updated config.toml file can be found at $HOME/.local/share/hyde/config.toml
"$schema" = "https://raw.githubusercontent.com/HyDE-Project/HyDE/refs/heads/master/Configs/.local/share/hyde/schema/config.toml.json"

[wallpaper]
custom_paths = [
    "@HOME@/Nextcloud/my_wallpapers",
]

[waybar]
scale = 12
icon_size = 9
font = "Atkinson Hyperlegible Next SemiBold"

[desktop.ui]
cursor_theme = "Future-cursors"
cursor_size = 46
font = "Atkinson Hyperlegible Next Medium"
font_size = 11
document_font = "Atkinson Hyperlegible Next Medium"
document_font_size = 11
monospace_font = "CaskaydiaCove Nerd Font Mono"
monospace_font_size = 10
font_antialiasing = "rgba"
font_hinting = "slight"

[gtk3]
font = "Atkinson Hyperlegible Next Medium"
font_size = 11

[qt5]
font = "Atkinson Hyperlegible Next Medium"
font_size = 11
monospace_font = "CaskaydiaCove Nerd Font Mono"
monospace_font_size = 10

[qt6]
font = "Atkinson Hyperlegible Next Medium"
font_size = 11
monospace_font = "CaskaydiaCove Nerd Font Mono"
monospace_font_size = 10

[notification]
font = "Atkinson Hyperlegible Next Medium"
font_size = 11

# HyDE reads duration_scale while it loads the animation preset, so the value
# has to live here and not in hyprland.lua, which runs after the preset.
[hyprland.anim]
duration_scale = 0.9
