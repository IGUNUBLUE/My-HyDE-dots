		"syntaxPunctuation": "punct",
		"thinkingOff": "bg2",
		"thinkingMinimal": "bg4",
		"thinkingLow": "info",
		"thinkingMedium": "blue",
		"thinkingHigh": "purple",
		"thinkingXhigh": "deepAccent",
		"thinkingMax": "accent",
		"bashMode": "cyan",
		"pythonMode": "warn",
		"statusLineBg": "bg1",
