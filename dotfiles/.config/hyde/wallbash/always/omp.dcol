		"customMessageBg": "bg2",
		"customMessageText": "text",
		"customMessageLabel": "purple",
		"toolPendingBg": "pendingBg",
		"toolSuccessBg": "successBg",
		"toolErrorBg": "errorBg",
		"toolText": "text",
		"toolTitle": "text",
		"toolOutput": "muted",
		"mdHeading": "accent",
		"mdLink": "info",
		"mdLinkUrl": "bg4",
		"mdCode": "purple",
