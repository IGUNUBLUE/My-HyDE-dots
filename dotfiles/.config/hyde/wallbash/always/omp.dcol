		"accentSoft": "#<wallbash_2xa5>",
		"good": "#@ANSI10@",
		"bad": "#@ANSI9@",
		"warn": "#@ANSI11@",
		"info": "#@ANSI12@",
		"purple": "#@ANSI13@",
		"cyan": "#@ANSI14@",
		"grey": "#@ANSI8@",
		"blue": "#@ANSI4@",
		"deepAccent": "#@ANSI5@",
		"pendingBg": "#@MIX_3@",
		"successBg": "#@MIX_2@",
