$HOME/.config/rofi/theme.rasi
/* LAGC Tech Light: documented HyDE Rofi color contract. */
* {
    main-bg:            #F7FCFDFF;
    main-fg:            #061B2BFF;
    main-br:            #B9D2DBFF;
    main-ex:            #EAF7FAFF;
    select-bg:          #17D7E8FF;
    select-fg:          #061B2BFF;
    separatorcolor:     transparent;
    border-color:       transparent;
}
