$HOME/.config/rofi/theme.rasi
/* LAGC Tech Light: documented HyDE Rofi color contract. */
* {
    main-bg:            #D9ECF0FF;
    main-fg:            #0C1C28FF;
    main-br:            #BED0D6FF;
    main-ex:            #DDEEF2FF;
    select-bg:          #34BFCBFF;
    select-fg:          #0C1C28FF;
    separatorcolor:     transparent;
    border-color:       transparent;
}
