$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* LAGC Tech Light: documented HyDE Waybar color contract. */
@define-color bar-bg rgba(247, 252, 253, 1.0);

@define-color main-bg #D9ECF0;
@define-color main-fg #0C1C28;

@define-color wb-act-bg #3B6ADF;
@define-color wb-act-fg #E2E2E2;

@define-color wb-hvr-bg #34BFCB;
@define-color wb-hvr-fg #0C1C28;

/* Semantic state colors; every value meets WCAG AA >=4.5:1 on main-bg. */
@define-color wb-ok-fg #1B656B;
@define-color wb-info-fg #3B6ADF;
@define-color wb-warn-fg #A94C25;
@define-color wb-crit-fg #A33232;
