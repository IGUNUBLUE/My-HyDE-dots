$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* LAGC Tech Light: documented HyDE Waybar color contract. */
@define-color bar-bg rgba(247, 252, 253, 1.0);

@define-color main-bg #F7FCFD;
@define-color main-fg #061B2B;

@define-color wb-act-bg #1B5CFF;
@define-color wb-act-fg #FFFFFF;

@define-color wb-hvr-bg #17D7E8;
@define-color wb-hvr-fg #061B2B;

/* Semantic state colors; every value meets WCAG AA >=4.5:1 on main-bg. */
@define-color wb-ok-fg #0B727B;
@define-color wb-info-fg #1B5CFF;
@define-color wb-warn-fg #C2410C;
@define-color wb-crit-fg #B91C1C;
