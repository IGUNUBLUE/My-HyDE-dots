$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* LAGC Calm Light: documented HyDE Waybar color contract. */
@define-color bar-bg rgba(244, 238, 226, 1.0);

@define-color main-bg #F4EEE2;
@define-color main-fg #3A342C;

@define-color wb-act-bg #5C7040;
@define-color wb-act-fg #F4EEE2;

@define-color wb-hvr-bg #A9C080;
@define-color wb-hvr-fg #3A342C;

/* Semantic state colors; every value meets WCAG AA >=4.5:1 on main-bg. */
@define-color wb-ok-fg #5C7040;
@define-color wb-info-fg #55655E;
@define-color wb-warn-fg #8A5A1E;
@define-color wb-crit-fg #9E4F43;
