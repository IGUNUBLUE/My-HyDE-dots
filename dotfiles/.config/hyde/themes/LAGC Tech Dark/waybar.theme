$HOME/.config/waybar/theme.css|${scrDir}/wbarconfgen.sh
/* LAGC Tech Dark: documented HyDE Waybar color contract. */
@define-color bar-bg rgba(6, 27, 43, 1.0);

@define-color main-bg #061B2B;
@define-color main-fg #EAF7FA;

@define-color wb-act-bg #1B5CFF;
@define-color wb-act-fg #FFFFFF;

@define-color wb-hvr-bg #17D7E8;
@define-color wb-hvr-fg #061B2B;

/* Semantic state colors; every value meets WCAG AA >=4.5:1 on main-bg. */
@define-color wb-ok-fg #17D7E8;
@define-color wb-info-fg #6B8CFF;
@define-color wb-warn-fg #FF7A3D;
@define-color wb-crit-fg #F97066;
