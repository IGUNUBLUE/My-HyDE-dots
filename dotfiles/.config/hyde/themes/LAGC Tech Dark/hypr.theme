$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf
# LAGC Tech Dark: native HyDE theme configuration.
# Palette: midnight #0C1C28, cyan #34BFCB, cobalt #3B6ADF, ember #E48458.

$GTK_THEME=Wallbash-Gtk
$ICON_THEME=Tela-circle-blue
$CURSOR_THEME=Future-cursors
$CURSOR_SIZE=46
$COLOR_SCHEME=prefer-dark

general {
    gaps_in = 2
    gaps_out = 4
    border_size = 2
    col.active_border = rgba(34bfcbff) rgba(628ae5ff) 45deg
    col.inactive_border = rgba(5E707C80)
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(34bfcbff) rgba(628ae5ff) 45deg
    col.border_inactive = rgba(5E707C80)
    col.border_locked_active = rgba(e48458ff) rgba(34bfcbff) 45deg
    col.border_locked_inactive = rgba(5E707C80)
}

decoration {
    rounding = 10
    shadow:enabled = false

    blur {
        enabled = no
    }
}
