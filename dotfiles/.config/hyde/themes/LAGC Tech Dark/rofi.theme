$HOME/.config/rofi/theme.rasi
/* LAGC Tech Dark: documented HyDE Rofi color contract. */
* {
    main-bg:            #061B2BFF;
    main-fg:            #EAF7FAFF;
    main-br:            #164B60FF;
    main-ex:            #0A2740FF;
    select-bg:          #17D7E8FF;
    select-fg:          #061B2BFF;
    separatorcolor:     transparent;
    border-color:       transparent;
}
