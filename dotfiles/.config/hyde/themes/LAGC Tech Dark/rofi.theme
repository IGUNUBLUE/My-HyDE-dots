$HOME/.config/rofi/theme.rasi
/* LAGC Tech Dark: documented HyDE Rofi color contract. */
* {
    main-bg:            #0C1C28FF;
    main-fg:            #DDEEF2FF;
    main-br:            #204756FF;
    main-ex:            #122638FF;
    select-bg:          #34BFCBFF;
    select-fg:          #0C1C28FF;
    separatorcolor:     transparent;
    border-color:       transparent;
}
